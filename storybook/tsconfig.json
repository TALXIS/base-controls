{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@talxis/base-controls": [
        "../src/index.ts"
      ],
      "@talxis/base-controls/*": [
        "../src/*"
      ],
      "@core": [
        "../src/core/index.ts"
      ],
      "@core/*": [
        "../src/core/*"
      ],
      "@theme": [
        "../src/theme/index.ts"
      ],
      "@theme/*": [
        "../src/theme/*"
      ],
      "@ui": [
        "../src/ui/index.ts"
      ],
      "@ui/*": [
        "../src/ui/*"
      ],
      "@fields": [
        "../src/fields/index.ts"
      ],
      "@fields/*": [
        "../src/fields/*"
      ],
      "@data": [
        "../src/data/index.ts"
      ],
      "@data/*": [
        "../src/data/*"
      ],
      "@controls": [
        "../src/controls/index.ts"
      ],
      "@controls/*": [
        "../src/controls/*"
      ],
      "@labels": [
        "../src/labels/index.ts"
      ],
      "@labels/*": [
        "../src/labels/*"
      ],
      "@pcf": [
        "../src/pcf/index.ts"
      ],
      "@pcf/*": [
        "../src/pcf/*"
      ],
      "@legacy": [
        "../src/legacy/react-components/index.ts"
      ],
      "@legacy/*": [
        "../src/legacy/react-components/*"
      ],
      "@/*": [
        "../src/*"
      ]
    }
  },
  "include": [
    "src",
    ".storybook"
  ]
}
