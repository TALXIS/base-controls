{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@talxis/base-controls": [
        "../src/index.ts"
      ],
      "@talxis/base-controls/*": [
        "../src/*"
      ]
    },
    "types": [
      "vite/client",
      "node",
      "google.maps",
      "powerapps-component-framework",
      "xrm"
    ]
  },
  "include": [
    "src",
    ".storybook"
  ]
}
